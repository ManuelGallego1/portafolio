# Copy to .env and replace every value. Never commit .env.

# Host ports (the backend is bound to 127.0.0.1 only)
FRONTEND_PORT=3000
BACKEND_PORT=8090

# PostgreSQL
POSTGRES_USER=portafolio
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=portafolio

# HMAC (Snake sessions) and JWT (admin) signing key, at least 32 characters.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Admin console (/admin)
ADMIN_USERNAME=
# Recommended: a bcrypt hash instead of a plain password. Generate it with:
# python -c "import bcrypt, getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt(12)).decode())"
# Wrap it in single quotes so Docker Compose keeps the "$" characters: ADMIN_PASSWORD_HASH='$2b$12$...'
ADMIN_PASSWORD_HASH=
# Fallback (at least 12 characters) used only when ADMIN_PASSWORD_HASH is empty.
ADMIN_PASSWORD=
JWT_EXPIRE_MINUTES=120

# Session cookie is sent only over HTTPS. Browsers allow it on http://localhost.
COOKIE_SECURE=true

# Reverse proxies in front of the backend that append X-Forwarded-For.
# 1 = only the Next.js frontend; 2 = Next.js behind another proxy (Nginx, Cloudflare...).
TRUSTED_PROXY_HOPS=1

CORS_ORIGINS=http://localhost:3000,https://alejandrogallego.dev

# Expose /api/docs (Swagger). Keep false in production.
ENABLE_DOCS=false
